# Supabase Database URLs
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres"

# Supabase Public API Keys
NEXT_PUBLIC_SUPABASE_URL="https://<ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="<anon-key>"

# NextAuth v5 Secret
AUTH_SECRET="<random-32-byte-hex-string>"

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Authorized JavaScript Origins:
#   http://localhost:3000
#   https://web-portal-drab.vercel.app
# Authorized Redirect URIs:
#   http://localhost:3000/api/auth/callback/google
#   https://web-portal-drab.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
